# Server
NODE_ENV=development
PORT=5000

# Public URL where short links live (no trailing slash), e.g. https://lnk.yourdomain.in
BASE_URL=http://localhost:5000
# Frontend origin for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173
# Extra origins allowed by CORS (comma separated), e.g. your production domain
CORS_ORIGINS=

# Database
MONGO_URI=mongodb+srv://merndevelopersidd_db_user:lQik0JfyTeumjak6@cluster0.v84fe0p.mongodb.net/URLSHORTNER

# Click counting runs inside the API. Set to false only if you run `npm run worker` separately
RUN_CLICK_WORKER=true
# Per-click debug logs ([click] ...). Set to false once everything works
LOG_CLICKS=true

# Redis (used for cache, ID counter, quotas and the BullMQ click queue)
REDIS_URL=redis://127.0.0.1:6379

# Auth: use a long random string in production (openssl rand -hex 32)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional: Google Safe Browsing API key. Leave empty to skip malware checks in dev.
SAFE_BROWSING_API_KEY=

# Email of the account that should be auto-promoted to admin on register
ADMIN_EMAIL=

# Brand name shown in Razorpay Checkout
BUSINESS_NAME=Linkzy

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type when creating the webhook in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=
# Filled from the output of: npm run razorpay:plans
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
